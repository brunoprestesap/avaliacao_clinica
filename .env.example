# Persistência: "json" (padrão, usa data/*.json) ou "mongo"
# Em produção, defina PERSISTENCE=mongo explicitamente —
# sem isso a aplicação usa data/*.json (não persiste em serverless/Vercel).
# PERSISTENCE=json

# MongoDB (obrigatório quando PERSISTENCE=mongo e para auth)
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/avaliacao?retryWrites=true&w=majority

# NextAuth v4
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=gere-um-secret-forte

# Google OAuth (opcional; sem config o login com Google fica indisponível)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (recuperação de senha e desbloqueio). Sem RESEND_API_KEY, em dev o link é logado no console.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@seudominio.com

# Opcional: URL do site (para links em emails). Fallback: VERCEL_URL ou localhost
# NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Opcional: diretório dos JSON quando PERSISTENCE=json
# DATA_DIR=./data
