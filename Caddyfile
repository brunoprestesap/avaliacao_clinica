# Sem domínio ainda: serve por HTTP puro no IP da VPS (ex: http://203.0.113.10).
# Sem certificado TLS confiável nesse modo — use apenas para validar a migração.
:80 {
	reverse_proxy app:3000
	encode gzip zstd
}

